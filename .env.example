# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Fleet JSON storage ─────────────────────────────────────────────────────────
# Path to the JSON file that persists router fleet data.
# Relative to the project root.
FLEET_DATA_PATH=./data/fleet.json

# ── SSH defaults ──────────────────────────────────────────────────────────────
# Credentials applied when a router has none set (can be overridden per router).
SSH_DEFAULT_USER=noc-admin
SSH_DEFAULT_PORT=22

# Optional: path to an SSH private key used as default when no password is set.
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# Timeout (ms) waiting for SSH connect
SSH_CONNECT_TIMEOUT=10000

# Timeout (ms) for a single show command
SSH_EXEC_TIMEOUT=30000

# After this many ms idle, a pooled SSH connection is closed
SSH_IDLE_TIMEOUT=1800000

# ── Metrics polling ───────────────────────────────────────────────────────────
# How often to poll each router that has an active WebSocket subscriber (ms)
METRICS_POLL_INTERVAL=15000

# How long a metrics snapshot is considered fresh (ms)
METRICS_CACHE_TTL=30000

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Use * to allow all (not recommended in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to 'true' to log every SSH command executed (useful for debugging).
LOG_SSH_COMMANDS=false
